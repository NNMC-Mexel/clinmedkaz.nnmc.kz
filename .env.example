NODE_ENV=development
PORT=1337
BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:1337
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Production domains:
# NODE_ENV=production
# BASE_URL=https://clinmedkaz.nnmc.kz
# FRONTEND_URL=https://clinmedkaz.nnmc.kz
# BACKEND_URL=https://clinmedkazserver.nnmc.kz
# STRAPI_URL=https://clinmedkazserver.nnmc.kz
# CORS_ORIGINS=https://clinmedkaz.nnmc.kz
# STRAPI_PROXY=true

# Required Strapi secrets. Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_KEYS=change-me-key-1,change-me-key-2,change-me-key-3,change-me-key-4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-strapi-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
ENCRYPTION_KEY=change-me-encryption-key
JWT_SECRET=change-me-users-permissions-jwt-secret

# Content API users are not payment administrators. List the existing usernames
# or emails that bootstrap should assign to the isolated Payment Admin role.
PAYMENT_ADMIN_USERS=admin
PAYMENT_ADMIN_EMAILS=

# Notification recipient for operational emails.
ADMIN_EMAIL=Nnmc.marketing@gmail.com

# Backend is Strapi in ./server. Client talks to it through REST /api/*.
STRAPI_URL=http://localhost:1337

# Publication fee. KZT is the base currency: it is the amount Halyk ePay charges
# residents of Kazakhstan and the headline price on the site. The USD figure shown
# to non-residents is derived as PUBLICATION_FEE_KZT / USD_TO_KZT_RATE.
#
# These are only the initial defaults. Once an admin saves a price in the admin
# panel (tab "Цена", stored in the pricing-setting single type), the saved value
# wins and these variables are ignored.
PUBLICATION_FEE_KZT=145620
USD_TO_KZT_RATE=485.4
# Legacy fallback: used to derive the KZT amount when PUBLICATION_FEE_KZT is unset.
PUBLICATION_FEE_USD=300

# Halyk ePay credentials. Fill with test credentials locally, and replace ALL
# values with production credentials before going live. Never commit real secrets.
PAYMENTS_ENABLED=true
HALYK_ENV=test
HALYK_CLIENT_ID=change-me-halyk-client-id
HALYK_CLIENT_SECRET=change-me-halyk-client-secret
HALYK_TERMINAL_ID=change-me-halyk-terminal-id
# Until production credentials are issued, set PAYMENTS_ENABLED=false together
# with both sync flags and CRON_ENABLED=false. Payment operations will return 503
# while the content site and CMS remain available.
HALYK_STATUS_SYNC_ENABLED=true
PAYMENT_RECONCILIATION_CRON_ENABLED=true
CRON_ENABLED=true

# Optional SMTP. If missing, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ClinMedKaz payments <no-reply@clinmedkaz.org>"

# Legal/business details required by Halyk review.
BUSINESS_NAME="АО «Национальный научный медицинский центр»"
BUSINESS_COUNTRY="Kazakhstan"
BUSINESS_CITY="Astana"
BUSINESS_LEGAL_ADDRESS="пр. Абылай хана, 42"
BUSINESS_ACTUAL_ADDRESS="пр. Абылай хана, 42"
BUSINESS_BIN="000640000596"
BUSINESS_KBE=16
BUSINESS_WORK_HOURS="Mon-Fri 09:00-18:00"
SUPPORT_PHONE="+7 (7172) 57-74-40"
SUPPORT_EMAIL=Nnmc.marketing@gmail.com
CHAIRMAN_NAME="Байгенжин Абай Кабатаевич"

BANK_NAME="АО «Народный банк»"
BANK_BIK=HSBKKZKX
BANK_KBE=14
BANK_IBAN=KZ806017111000000485
