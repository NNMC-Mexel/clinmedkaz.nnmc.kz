HOST=0.0.0.0
PORT=1337
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:1337
STRAPI_URL=http://localhost:1337
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Production domains:
# NODE_ENV=production
# FRONTEND_URL=https://clinmedkaz.nnmc.kz
# BACKEND_URL=https://clinmedkazserver.nnmc.kz
# STRAPI_URL=https://clinmedkazserver.nnmc.kz
# CORS_ORIGINS=https://clinmedkaz.nnmc.kz

# Generate long random values before production deployment.
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
ENCRYPTION_KEY=change-me-encryption-key
JWT_SECRET=change-me-jwt-secret

# Comma-separated users/emails assigned to the isolated Payment Admin role.
PAYMENT_ADMIN_USERS=admin
PAYMENT_ADMIN_EMAILS=

# Optional service token for protected maintenance endpoints.
PAYMENT_SERVICE_TOKEN=change-me-service-token

# Local default. Use postgres in production.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Enable bank-side reconciliation in production or Halyk-enabled staging.
HALYK_STATUS_SYNC_ENABLED=false
PAYMENT_RECONCILIATION_CRON_ENABLED=false
CRON_ENABLED=true

# PostgreSQL production example.
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/clinmedkaz_cms
# DATABASE_SSL=false
